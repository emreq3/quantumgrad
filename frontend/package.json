{
  "name": "qta6-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run_all.cjs",
    "e2e:perf": "node e2e/run_all.cjs --perf",
    "math:css": "node scripts/make_katex_css.mjs",
    "audio:build": "vite build -c vite.audiolab.config.ts",
    "audio:analyze": "npm run audio:build && node e2e/audio_analysis.cjs",
    "fonts:css": "node scripts/make_font_css.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "katex": "0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
